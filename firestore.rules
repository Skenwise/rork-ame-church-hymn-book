rules_version = '2';
// ============================================================================
// MERGED FIRESTORE RULES — single rulebook for the app AND the website.
// Keep this file identical in both repositories:
//   - rork-ame-church-hymn-book (app repo)
//   - 17thEpiscopalDistrictRAYAC (website repo)
// Deploy from the website repo: firebase deploy --only firestore:rules
//
// Design:
//  - Users manage their OWN record with constraints (premium frozen,
//    devices capped at 2 — the 2-device limit).
//  - Sensitive data (payments, pendingUnlocks) is server-only.
//  - Public content stays publicly readable.
//  - Unlisted collections are DENIED (no catch-all).
//
// KNOWN LIMITATION (follow-up hardening project):
//  - Website admin panels rely on isAdmin() == isAuthenticated() today,
//    so other-uid user edits/deletes are still possible for any signed-in
//    user. Self-granting premium is blocked; real admin auth (custom
//    claims) is a separate task.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    // ============================================
    // USERS (app + website accounts)
    // ============================================
    match /users/{userId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.auth.uid == userId
        && (!('premiumUnlocked' in request.resource.data)
            || request.resource.data.premiumUnlocked == false
            // Pay-then-join: premium may start true only when the payment
            // webhook left a pending unlock for this exact email.
            || (
              request.resource.data.premiumUnlocked == true
              && request.resource.data.email is string
              && get(/databases/$(database)/documents/pendingUnlocks/$(request.resource.data.email)).exists
            ))
        && (!('devices' in request.resource.data)
            || request.resource.data.devices.size() <= 2);
      allow update: if isAuthed() && (
        // Legacy admin-panel edits (MembersAdmin toggle/delete) — see
        // KNOWN LIMITATION above.
        request.auth.uid != userId
        || (
          request.auth.uid == userId
          // premiumUnlocked is FROZEN on self-edits: only the payment
          // webhook / server functions may change it — unless a pending
          // unlock exists for this user's email (pay-then-join flow).
          && (!('premiumUnlocked' in request.resource.data)
              || request.resource.data.premiumUnlocked == resource.data.premiumUnlocked
              || (
                request.resource.data.premiumUnlocked == true
                && get(/databases/$(database)/documents/pendingUnlocks/$(request.auth.token.email)).exists
              ))
          && (!('email' in request.resource.data)
              || request.resource.data.email == resource.data.email)
          // 2-device limit, enforced in the database itself.
          && (!('devices' in request.resource.data)
              || request.resource.data.devices.size() <= 2)
        )
      );
      allow delete: if isAuthed() && request.auth.uid != userId; // admin panel
    }

    // ============================================
    // SERVER-ONLY (Cloud Functions / Admin SDK)
    // ============================================
    match /payments/{paymentId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if false; // webhook & reports use Admin SDK
    }

    match /pendingUnlocks/{email} {
      // Created only by the payment webhook (Admin SDK). The owner may
      // read/delete their OWN pending unlock (legacy client-side apply
      // flow used by join/sign-up).
      allow read: if isAuthed() && request.auth.token.email == email;
      allow delete: if isAuthed() && request.auth.token.email == email;
      allow create, update: if false; // server only
    }

    // ============================================
    // PUBLIC CONTENT (anonymous read, authed write)
    // ============================================
    match /events/{document} {
      allow read: if true;
      allow write: if isAuthed();
    }
    match /trainings/{document} {
      allow read: if true;
      allow write: if isAuthed();
    }
    match /gallery_images/{document} {
      allow read: if true;
      allow write: if isAuthed();
    }
    match /resources/{document} {
      allow read: if true;
      allow write: if isAuthed();
    }
    match /store_items/{document} {
      allow read: if true;
      allow write: if isAuthed();
    }
    match /store_products/{document} {
      allow read: if true;
      allow write: if isAuthed();
    }
    match /prayer_requests/{document} {
      allow read, write: if true; // anyone can submit & browse
    }

    // ============================================
    // MEMBER CONTENT (authed)
    // ============================================
    match /members/{document} {
      allow read, write: if isAuthed();
    }
    match /training_enrollments/{document} {
      allow read, write: if isAuthed();
    }
    match /event_rsvps/{document} {
      allow read, write: if isAuthed();
    }
    match /rsvps/{document} {
      allow read, write: if isAuthed();
    }
    match /volunteer_applications/{document} {
      allow read, write: if isAuthed();
    }
    match /donations/{document} {
      allow read, write: if isAuthed();
    }
    match /forum_posts/{document} {
      allow read, write: if isAuthed();
    }
    match /forum_comments/{document} {
      allow read, write: if isAuthed();
    }
    match /forum_threads/{document} {
      allow read, write: if isAuthed();
    }

    // ============================================
    // NOTIFICATIONS (per-user subcollection)
    // ============================================
    match /notifications/{userId} {
      allow read, write: if isAuthed();
      match /items/{itemId} {
        allow read, write: if isAuthed();
      }
    }

    // ============================================
    // ADMINS list (legacy: authed read/write)
    // ============================================
    match /admins/{document} {
      allow read, write: if isAuthed();
    }

    // No catch-all: any collection not listed above is denied.
  }
}
